{
  "server": {
    "host": "127.0.0.1",
    "port": 4141
  },
  "prompt": {
    "mode": "replace",
    "file": "system_prompt.txt"
  },
  "provider": {
    "name": "Ollama Local",
    "transport": "ollama-native",
    "baseURL": "http://127.0.0.1:11434",
    "model": "qwen3",
    "forceModel": true,
    "apiKeyEnv": "PROVIDER_API_KEY",
    "auth": {
      "type": "none"
    },
    "chatPath": "/api/chat",
    "modelsPath": "/v1/models",
    "headers": {}
  },
  "reasoning": {
    "default": "low",
    "injectDefault": true
  },
  "logging": {
    "requests": true
  }
}
